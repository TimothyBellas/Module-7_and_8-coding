# Copy to .env when cloning from GitHub. The download already includes a safe .env.
# These are service names inside Compose, not addresses for your Windows browser.
OLLAMA_URL=http://ollama:11434
BACKEND_URL=http://backend:8000
MODEL_NAME=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
CHROMA_PATH=/app/chroma_data
DOCS_PATH=/app/backend/docs
COLLECTION_NAME=course_notes
MAX_RESULTS=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=16
# Cosine distance: smaller is closer; only distances BELOW this value are used.
CONFIDENCE_THRESHOLD=0.55
HIGH_CONFIDENCE_THRESHOLD=0.30
REQUEST_TIMEOUT=300
HEALTH_TIMEOUT=3
FRONTEND_TIMEOUT=600
STATUS_TIMEOUT=5
TEMPERATURE=0.1
CONTEXT_WINDOW=8192
MAX_ANSWER_TOKENS=512
AUTO_INGEST=true
DEBUG=false
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
BACKEND_PORT=8000
FRONTEND_PORT=8501
OLLAMA_PORT=11434
OLLAMA_IMAGE_TAG=latest
BACKEND_HEALTH_URL=http://127.0.0.1:8000/health
FRONTEND_HEALTH_URL=http://127.0.0.1:8501/_stcore/health
# CPU mode works without GPU configuration. Limit parallel model memory usage.
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
